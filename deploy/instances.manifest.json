{
  "version": 2,
  "defaults": {
    "apps_dir": "/srv/zawadi/apps",
    "main_dir": "/srv/zawadi/apps/zawadijrn",
    "env_dir": "/srv/zawadi/apps/env",
    "backup_dir": "/srv/zawadi/backups",
    "stack_compose_file": "docker-compose.stack.yml",
    "frontend_image": "ghcr.io/amalgamate/zawadi-frontend",
    "backend_image": "ghcr.io/amalgamate/zawadi-backend",
    "console_image": "ghcr.io/amalgamate/zawadi-console",
    "health_host": "127.0.0.1",
    "static_publish_dir": "/srv/zawadi/apps/zawadijrn/build"
  },
  "instances": [
    {
      "id": "demo",
      "aliases": ["demoschool", "demo-school"],
      "label": "Canary — Demo School",
      "tier": "demo",
      "active": true,
      "deployment_allowed": true,
      "kind": "stack",
      "compose_project": "zawadi-demoschool",
      "env_file": "/srv/zawadi/apps/env/.zawadi-demoschool.env",
      "public_domain": "demoschool.trendscore.co.ke",
      "auto_deploy_on_main": true,
      "notes": "QA canary stack with its own compose project, database volume, ports, and env file. It must stay isolated from JRN production."
    },
    {
      "id": "ighs",
      "label": "IGHS",
      "tier": "production",
      "active": true,
      "deployment_allowed": true,
      "kind": "stack",
      "compose_project": "ighs",
      "env_file": "/srv/zawadi/apps/.env.ighs",
      "public_domain": "ighs.trendscore.co.ke"
    },
    {
      "id": "jrn",
      "aliases": ["zawadi-junior", "zawadi-jrn", "zawadijrn"],
      "label": "JRN — Zawadi",
      "tier": "production",
      "active": true,
      "deployment_allowed": true,
      "kind": "main",
      "compose_project": "zawadijrn",
      "public_domain": "zawadi.trendscore.co.ke",
      "notes": "Live JRN site on the main zawadijrn stack. demoschool is the QA canary URL on the same stack."
    },
    {
      "id": "kambigarba-cs",
      "label": "Kambi Garba CS",
      "tier": "production",
      "active": true,
      "deployment_allowed": true,
      "kind": "stack",
      "compose_project": "kambigarba-cs",
      "env_file": "/srv/zawadi/apps/env/.kambigarba-cs.env",
      "public_domain": "kambigarba-cs.trendscore.co.ke"
    },
    {
      "id": "lionscomplex",
      "aliases": ["lions-complex"],
      "label": "Lions Complex",
      "tier": "production",
      "active": true,
      "deployment_allowed": true,
      "kind": "stack",
      "compose_project": "lions-complex",
      "env_file": "/srv/zawadi/apps/env/.lions-complex.env",
      "public_domain": "lionscomplex.trendscore.co.ke"
    },
    {
      "id": "mck",
      "label": "MCK",
      "tier": "production",
      "active": true,
      "deployment_allowed": true,
      "kind": "stack",
      "compose_project": "mck",
      "env_file": "/srv/zawadi/apps/.env.mck",
      "public_domain": "mck.trendscore.co.ke"
    },
    {
      "id": "merti-cs",
      "label": "Merti Complex School",
      "tier": "production",
      "active": true,
      "deployment_allowed": true,
      "kind": "stack",
      "compose_project": "mertics",
      "env_file": "/srv/zawadi/apps/.env.merti-cs",
      "public_domain": "merti-cs.trendscore.co.ke"
    },
    {
      "id": "waso-cs",
      "aliases": ["waso"],
      "label": "Waso CS",
      "tier": "production",
      "active": true,
      "deployment_allowed": true,
      "kind": "stack",
      "compose_project": "zawadi-waso-cs",
      "env_file": "/srv/zawadi/apps/env/.zawadi-waso-cs.env",
      "public_domain": "waso-cs.trendscore.co.ke"
    },
    {
      "id": "daawa-cs",
      "aliases": ["daawa"],
      "label": "Daawa CS",
      "tier": "production",
      "active": true,
      "deployment_allowed": true,
      "kind": "stack",
      "compose_project": "zawadi-daawa-cs",
      "env_file": "/srv/zawadi/apps/env/.zawadi-daawa-cs.env",
      "public_domain": "daawa-cs.trendscore.co.ke"
    },
    {
      "id": "barracks-comprehesive-school",
      "aliases": ["barracks", "baracks"],
      "label": "Barracks Comprehensive School",
      "tier": "production",
      "active": true,
      "deployment_allowed": true,
      "kind": "stack",
      "compose_project": "zawadi-barracks-comprehesive-school",
      "env_file": "/srv/zawadi/apps/env/.zawadi-barracks-comprehesive-school.env",
      "public_domain": "barracks-comprehesive-school.trendscore.co.ke"
    },
    {
      "id": "ibse",
      "label": "IBSE",
      "tier": "production",
      "active": false,
      "deployment_allowed": false,
      "kind": "stack",
      "compose_project": "ibse",
      "notes": "Discovered dynamically but not yet baselined — Prisma P3005 on every deploy. Set deployment_allowed=true after running prisma migrate deploy --baseline on the ibse database."
    }
  ],
  "discovery": {
    "enabled": false,
    "default_tier": "production",
    "school_stack_only": true,
    "exclude_compose_projects": [
      "zawadijrn",
      "zawadi-amalgamate-images",
      "zawadi-naet",
      "zawadi-zayan-electricals",
      "ibse"
    ],
    "notes": "Discovery disabled — all production schools are explicitly listed above. ibse excluded until its database is baselined (Prisma P3005)."
  }
}
