// Personalized career fit score for a learner
model LearnerCareerMatch {
  id               String   @id @default(uuid())
  learnerId        String
  careerId         String
  fitScore         Float    @default(0)
  confidence       String   @default("INSUFFICIENT_DATA") // HIGH | MEDIUM | LOW | INSUFFICIENT_DATA
  bucket           String   @default("INSUFFICIENT_DATA") // STRONG_FIT | GOOD_FIT | EXPLORE | ASPIRATIONAL | ALTERNATIVE | INSUFFICIENT_DATA
  matchedStrengths String[] @default([])
  developmentAreas String[] @default([])
  warnings         String[] @default([])
  scoreVersion     String   @default("1.0")
  generatedAt      DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  learner          Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  career           Career   @relation(fields: [careerId], references: [id], onDelete: Cascade)

  @@unique([learnerId, careerId])
  @@index([learnerId])
  @@index([careerId])
  @@index([learnerId, fitScore(sort: Desc)])
  @@map("learner_career_matches")
}

// Learner (or parent/counsellor) saves a career for later
model LearnerCareerSave {
  id            String   @id @default(uuid())
  learnerId     String
  careerId      String
  savedBy       String // user id
  savedByRole   String // STUDENT | PARENT | HEAD_OF_CURRICULUM | etc.
  priority      Int      @default(0)
  note          String?
  supportStatus String   @default("LEARNER_INTERESTED") // LEARNER_INTERESTED | PARENT_SUPPORTS | PARENT_UNCERTAIN | COUNSELLOR_RECOMMENDS | UNDER_DISCUSSION | REMOVED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  learner       Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  career        Career   @relation(fields: [careerId], references: [id], onDelete: Cascade)

  @@unique([learnerId, careerId])
  @@index([learnerId])
  @@index([careerId])
  @@map("learner_career_saves")
}

// Versioned administration records for the Pathway Decision Centre. The live
// domain tables remain the read model; each publish/retire operation preserves
// an immutable snapshot here for rollback and audit.
model PathwayContentVersion {
  id          String    @id @default(uuid())
  entityType  String
  entityId    String
  version     Int
  status      String    @default("DRAFT") // DRAFT | IN_REVIEW | PUBLISHED | SCHEDULED | RETIRED
  snapshot    Json
  reason      String?
  effectiveAt DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  @@unique([entityType, entityId, version])
  @@index([entityType, status])
  @@map("pathway_content_versions")
}

model PathwayRuleSet {
  id          String    @id @default(uuid())
  domain      String
  name        String
  version     Int
  status      String    @default("DRAFT") // DRAFT | PUBLISHED | RETIRED
  config      Json
  reason      String?
  publishedAt DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([domain, version])
  @@index([domain, status])
  @@map("pathway_rule_sets")
}

model PathwayImportJob {
  id             String    @id @default(uuid())
  domain         String
  fileName       String
  status         String    @default("UPLOADED")
  payload        Json
  preview        Json?
  errors         Json?
  totalRows      Int       @default(0)
  processedRows  Int       @default(0)
  failedRows     Int       @default(0)
  idempotencyKey String?   @unique
  createdById    String?
  approvedById   String?
  approvedAt     DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([domain, status])
  @@map("pathway_import_jobs")
}
