generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String          @id @default(uuid())
  email                   String          @unique
  username                String?         @unique
  password                String
  firstName               String
  lastName                String
  middleName              String?
  phone                   String?
  role                    UserRole        @default(TEACHER)
  roles                   UserRole[]      @default([])
  status                  UserStatus      @default(ACTIVE)
  institutionType         InstitutionType @default(PRIMARY_CBC)
  archived                Boolean         @default(false)
  archivedAt              DateTime?
  archivedBy              String?
  emailVerificationToken  String?
  emailVerificationSentAt DateTime?
  phoneVerificationCode   String?
  phoneVerificationSentAt DateTime?
  verificationRequired    Boolean         @default(true)
  staffId                 String?         @unique
  idCardPhoto             String?
  idCardIssued            DateTime?
  idCardExpiry            DateTime?
  lastLogin               DateTime?
  emailVerified           Boolean         @default(false)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  loginAttempts           Int             @default(0)
  lockedUntil             DateTime?
  passwordResetToken      String?
  passwordResetExpiry     DateTime?
  profilePicture          String?
  bankAccountName         String?
  bankAccountNumber       String?
  bankName                String?
  basicSalary             Decimal?        @db.Decimal(10, 2)
  employmentType          String?         @default("PERMANENT")
  joinedAt                DateTime?       @default(now())
  kraPin                  String?
  nhifNumber              String?
  nssfNumber              String?
  subject                 String?
  gender                  String?
  // shifNumber removed to prevent P2022 conflicts. Use nhifNumber for insurance tracking.

  housingLevyExempt          Boolean                     @default(false)
  createdAggregationConfigs  AggregationConfig[]
  assignedAssets             AssetAssignment[]           @relation("AssetUser")
  attendancesMarked          Attendance[]                @relation("AttendanceMarker")
  biometricCredentials       BiometricCredential[]
  changeHistory              ChangeHistory[]
  schedules                  ClassSchedule[]             @relation("TeacherSchedules")
  classesAsTeacher           Class[]                     @relation("ClassTeacher")
  recordedCoCurricular       CoCurricularActivity[]      @relation("RecorderCoCurricular")
  createdContactGroups       ContactGroup[]              @relation("CreatedContactGroups")
  assessedCoreCompetencies   CoreCompetency[]            @relation("AssessorCoreCompetencies")
  uploadedDocuments          Document[]
  createdEvents              Event[]                     @relation("EventCreator")
  recordedPayments           FeePayment[]                @relation("RecordedPayments")
  feeComments                FeeComment[]                @relation("FeeCommentAuthor")
  feePledges                 FeePledge[]                 @relation("FeePledgeCreator")
  feeWaivers                 FeeWaiver[]                 @relation("FeeWaiverCreator")
  approvedFeeWaivers         FeeWaiver[]                 @relation("FeeWaiverApprover")
  createdFeeStructures       FeeStructure[]              @relation("CreatedFeeStructures")
  waivedFines                Fine[]                      @relation("FineWaivers")
  formativeAssessments       FormativeAssessment[]       @relation("TeacherFormativeAssessments")
  familyMembership           FamilyMember?
  invitedFamilyMembers       FamilyMember[]              @relation("FamilyMemberInviter")
  learners                   Learner[]                   @relation("ParentLearners")
  approvedLeaves             LeaveRequest[]              @relation("ApprovedLeaves")
  leaveRequests              LeaveRequest[]              @relation("UserLeaves")
  libraryMember              LibraryMember?
  uploadedLMSContent         LMSContent[]                @relation("LMSUploadedContent")
  lmsCourses                 LMSCourse[]                 @relation("LMSCreatedCourses")
  lmsEnrollments             LMSEnrollment[]             @relation("LMSEnrolledBy")
  createdNotices             Notice[]                    @relation("NoticeAuthor")
  payrollRecords             PayrollRecord[]
  conductedReviews           PerformanceReview[]         @relation("ConductedReviews")
  performanceReviews         PerformanceReview[]         @relation("StaffReviews")
  schemesOfWork              SchemeOfWork[]              @relation("TeacherSchemes")
  staffAttendanceLogs        StaffAttendanceLog[]
  staffAttendanceAttemptLogs StaffAttendanceAttemptLog[]
  staffDocuments             StaffDocument[]
  staffAllowances            StaffAllowance[]
  staffDeductions            StaffDeduction[]
  approvedRequisitions       StockRequisition[]          @relation("ApprovedBy")
  inventoryRequisitions      StockRequisition[]          @relation("RequestedBy")
  subjectAssignments         SubjectAssignment[]
  summativeResultHistories   SummativeResultHistory[]    @relation("ChangedBy")
  recordedResults            SummativeResult[]           @relation("RecordedResults")
  approvedTests              SummativeTest[]             @relation("ApprovedTests")
  createdTests               SummativeTest[]             @relation("CreatedTests")
  submittedTests             SummativeTest[]             @relation("SubmittedTests")
  sentMessages               SupportMessage[]            @relation("SentMessages")
  notifications              UserNotification[]          @relation("UserNotifications")
  authOtpChallenges          AuthOtpChallenge[]
  assignedTickets            SupportTicket[]             @relation("AssignedTickets")
  tickets                    SupportTicket[]             @relation("UserTickets")
  createdTermConfigs         TermConfig[]
  assessedValues             ValuesAssessment[]          @relation("AssessorValues")
  pushSubscriptions          PushSubscription[]          @relation("UserPushSubscriptions")
  // ── In-App Messaging ────────────────────────────────────────────────────────
  conversationParticipants   ConversationParticipant[]
  sentChatMessages           ChatMessage[]               @relation("ChatMessageSender")
  chatMessageReactions       ChatMessageReaction[]       @relation("ChatReactionUser")
  createdConversations       Conversation[]
  // ── Apps Module ─────────────────────────────────────────────────────────────
  appConfigsUpdated          SchoolAppConfig[]           @relation("AppConfigUpdater")
  appAuditLogs               AppAuditLog[]               @relation("AppAuditor")
  dutyRosterAssignments      DutyRosterAssignment[]      @relation("DutyTeacher")
  dutyRostersCreated         DutyRoster[]
  approvalRequests           ApprovalRequest[]           @relation("ApprovalRequestor")
  approvalActions            ApprovalAction[]            @relation("ApprovalActioner")
  // ── LMS Digital Learning Hub ────────────────────────────────────────────────
  createdLessons             LearningLesson[]            @relation("LessonCreator")
  createdAssignments         LearningAssignment[]        @relation("AssignmentCreator")
  markedSubmissions          LearningSubmission[]        @relation("SubmissionMarker")
  uploadedResources          LearningResource[]          @relation("ResourceUploader")
  marketplaceListings        MarketplaceListing[]        @relation("MarketplaceSeller")
  marketplacePurchases       MarketplacePurchase[]       @relation("MarketplaceBuyer")
  // ── Pathway Planner ──────────────────────────────────────────────────────────
  counsellorNotesAuthored    CounsellorNote[]            @relation("CounsellorNoteAuthor")
  selectionUnlocksGranted    PathwaySelectionUnlock[]    @relation("SelectionUnlocker")
  parentCommentsAuthored     ParentComment[]             @relation("ParentCommentAuthor")
  counsellingSessionsHeld    CounsellingSession[]        @relation("CounsellingSessionCounsellor")
  pathwayInterventions       PathwayIntervention[]       @relation("PathwayInterventionCounsellor")

  // ── Performance indexes ─────────────────────────────────────────────────────────────────
  @@index([role, archived, status])
  @@index([archived])
  @@index([status, archived])
  @@map("users")
}

model School {
  id                                     String                     @id @default(uuid())
  name                                   String                     @unique
  registrationNo                         String?                    @unique
  address                                String?
  county                                 String?
  subCounty                              String?
  ward                                   String?
  phone                                  String?
  email                                  String?
  website                                String?
  principalName                          String?
  principalPhone                         String?
  logoUrl                                String?
  faviconUrl                             String?
  pwaLogoUrl                             String?
  schoolType                             String?
  motto                                  String?
  vision                                 String?
  mission                                String?
  admissionFormatType                    AdmissionFormatType        @default(BRANCH_PREFIX_START)
  branchSeparator                        String                     @default("-")
  admissionNumberMode                    AdmissionNumberingMode     @default(AUTO)
  admissionPattern                       String                     @default("ADM-{YEAR}-{SEQ}")
  admissionSequenceWidth                 Int                        @default(4)
  admissionStartNumber                   Int                        @default(1000)
  admissionResetRule                     AdmissionSequenceResetRule @default(YEARLY)
  admissionNumberingLocked               Boolean                    @default(true)
  active                                 Boolean                    @default(true)
  status                                 String                     @default("ACTIVE")
  institutionType                        InstitutionType            @default(PRIMARY_CBC)
  institutionTypeLocked                  Boolean                    @default(false)
  requiresUserVerification               Boolean                    @default(true)
  curriculumType                         CurriculumType             @default(CBC_AND_EXAM)
  assessmentMode                         AssessmentMode             @default(MIXED)
  customGradingScale                     Json?
  archived                               Boolean                    @default(false)
  archivedAt                             DateTime?
  archivedBy                             String?
  createdAt                              DateTime                   @default(now())
  updatedAt                              DateTime                   @updatedAt
  stampUrl                               String?
  latitude                               Float?
  longitude                              Float?
  geofenceRadiusMeters                   Int                        @default(30)
  geofenceEnforcementMode                GeofenceEnforcementMode    @default(OFF)
  allowedClockInIps                      String?
  attendanceLockEnabled                  Boolean                    @default(true)
  attendanceLockTime                     String                     @default("07:30")
  attendanceUnlockWindowMinutes          Int                        @default(60)
  attendanceAllowLateAfterLock           Boolean                    @default(true)
  attendanceRequireRemarksForLateExcused Boolean                    @default(true)
  attendanceNotifyAbsentDefault          Boolean                    @default(true)
  brandColor                             String?
  welcomeMessage                         String?
  welcomeTitle                           String?
  onboardingMessage                      String?
  onboardingTitle                        String?
  primaryColor                           String?
  secondaryColor                         String?
  accentColor1                           String?
  accentColor2                           String?
  kraPin                                 String?
  vatNumber                              String?
  etimsConfig                            Json?
  nemisConfig                            Json?

  tertiaryDepartments        TertiaryDepartment[]
  tertiaryPrograms           TertiaryProgram[]
  tertiaryUnits              TertiaryUnit[]
  aiGeneratedContents        AIGeneratedContent[]
  staffAttendanceLogs        StaffAttendanceLog[]
  staffAttendanceAttemptLogs StaffAttendanceAttemptLog[]

  // ── LMS Digital Learning Hub ────────────────────────────────────────────────
  learningLessons     LearningLesson[]
  learningAssignments LearningAssignment[]
  learningResources   LearningResource[]
  marketplaceListings MarketplaceListing[]
  lmsSettings         LMSSettings?

  @@index([kraPin])
  @@index([county])
  @@map("schools")
}

model AdmissionSequence {
  id           String    @id @default(uuid())
  academicYear Int       @unique
  currentValue Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  archived     Boolean   @default(false)
  archivedAt   DateTime?
  archivedBy   String?

  @@index([academicYear])
  @@map("admission_sequences")
}

model StaffSequence {
  id           String    @id @default(uuid())
  currentValue Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  archived     Boolean   @default(false)
  archivedAt   DateTime?
  archivedBy   String?

  @@map("staff_sequences")
}

model Stream {
  id         String    @id @default(uuid())
  name       String    @unique
  active     Boolean   @default(true)
  archived   Boolean   @default(false)
  archivedAt DateTime?
  archivedBy String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([name])
  @@map("streams")
}

model Notice {
  id             String    @id @default(uuid())
  createdById    String?
  title          String
  content        String
  category       String?
  priority       String    @default("NORMAL")
  status         String    @default("PUBLISHED")
  targetAudience String?
  publishedAt    DateTime  @default(now())
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archived       Boolean   @default(false)
  archivedAt     DateTime?
  archivedBy     String?
  createdBy      User?     @relation("NoticeAuthor", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([status, publishedAt])
  @@index([archived])
  @@map("notices")
}

model Class {
  id                  String               @id @default(uuid())
  classCode           String               @unique
  name                String
  grade               String
  stream              String?
  teacherId           String?
  academicYear        Int                  @default(2025)
  term                Term                 @default(TERM_1)
  capacity            Int                  @default(40)
  room                String?
  active              Boolean              @default(true)
  archived            Boolean              @default(false)
  archivedAt          DateTime?
  archivedBy          String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  institutionType     InstitutionType      @default(PRIMARY_CBC)
  assets              AssetAssignment[]    @relation("AssetClass")
  attendances         Attendance[]
  enrollments         ClassEnrollment[]
  facilities          ClassFacility[]
  schedules           ClassSchedule[]
  teacher             User?                @relation("ClassTeacher", fields: [teacherId], references: [id])
  // ── LMS Digital Learning Hub ────────────────────────────────────────────────
  learningLessons     LearningLesson[]
  learningAssignments LearningAssignment[]
  learningResources   LearningResource[]

  @@unique([grade, stream, academicYear, term])
  @@index([institutionType, grade, stream])
  @@index([teacherId])
  @@index([grade, stream])
  @@map("classes")
}

model ClassSchedule {
  id             String        @id @default(uuid())
  classId        String
  subject        String
  day            String
  startTime      String
  endTime        String
  room           String?
  teacherId      String?
  semester       String?
  academicYear   Int           @default(2025)
  notes          String?
  active         Boolean       @default(true)
  archived       Boolean       @default(false)
  archivedAt     DateTime?
  archivedBy     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  learningAreaId String?
  class          Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  learningArea   LearningArea? @relation(fields: [learningAreaId], references: [id])
  teacher        User?         @relation("TeacherSchedules", fields: [teacherId], references: [id])

  @@index([classId])
  @@index([day])
  @@index([subject])
  @@map("class_schedules")
}

model ClassFacility {
  id                  String    @id @default(uuid())
  classId             String
  facilityName        String
  facilityType        String
  quantity            Int       @default(1)
  condition           String    @default("FUNCTIONAL")
  maintenanceRequired Boolean   @default(false)
  lastMaintenance     DateTime?
  notes               String?
  active              Boolean   @default(true)
  archived            Boolean   @default(false)
  archivedAt          DateTime?
  archivedBy          String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  class               Class     @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([facilityType])
  @@index([condition])
  @@map("class_facilities")
}

model ClassEnrollment {
  id         String    @id @default(uuid())
  classId    String
  learnerId  String
  enrolledAt DateTime  @default(now())
  active     Boolean   @default(true)
  archived   Boolean   @default(false)
  archivedAt DateTime?
  archivedBy String?
  class      Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  learner    Learner   @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([classId, learnerId])
  @@index([classId])
  @@index([learnerId])
  @@index([learnerId, active])
  @@index([classId, active])
  @@map("class_enrollments")
}

model Learner {
  id                     String                         @id @default(uuid())
  admissionNumber        String                         @unique
  firstName              String
  lastName               String
  middleName             String?
  dateOfBirth            DateTime
  gender                 Gender
  photoUrl               String?
  photoPublicId          String?
  grade                  String
  stream                 String?
  parentId               String?
  guardianName           String?
  guardianPhone          String?
  guardianEmail          String?
  medicalConditions      String?
  allergies              String?
  emergencyContact       String?
  emergencyPhone         String?
  bloodGroup             String?
  address                String?
  county                 String?
  subCounty              String?
  status                 LearnerStatus                  @default(ACTIVE)
  admissionDate          DateTime                       @default(now())
  exitDate               DateTime?
  exitReason             String?
  previousSchool         String?
  religion               String?
  specialNeeds           String?
  isTransportStudent     Boolean                        @default(false)
  isScholarshipStudent   Boolean                        @default(false)
  scholarshipType        String?
  scholarshipAmount      Decimal?                       @db.Decimal(12, 2)
  feeConfigurations      LearnerFeeConfiguration[]
  idCardIssued           DateTime?
  idCardExpiry           DateTime?
  idCardNumber           String?
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  createdBy              String?
  updatedBy              String?
  archived               Boolean                        @default(false)
  archivedAt             DateTime?
  archivedBy             String?
  fatherName             String?
  fatherPhone            String?
  fatherEmail            String?
  fatherDeceased         Boolean                        @default(false)
  motherName             String?
  motherPhone            String?
  motherEmail            String?
  motherDeceased         Boolean                        @default(false)
  guardianRelation       String?
  primaryContactType     String?
  primaryContactName     String?
  primaryContactPhone    String?
  primaryContactEmail    String?
  institutionType        InstitutionType                @default(PRIMARY_CBC)
  pathwayId              String?
  upiNumber              String?                        @unique
  smsAudits              AssessmentSmsAudit[]           @relation("LearnerSmsAudits")
  attendances            Attendance[]
  biometricCredentials   BiometricCredential[]
  enrollments            ClassEnrollment[]
  coCurricularActivities CoCurricularActivity[]         @relation("LearnerCoCurricular")
  coreCompetencies       CoreCompetency[]               @relation("LearnerCoreCompetencies")
  feeInvoices            FeeInvoice[]                   @relation("LearnerInvoices")
  familyLinks            LearnerFamilyLink[]
  formativeAssessments   FormativeAssessment[]
  subjectSelections      LearnerSubjectSelection[]
  parent                 User?                          @relation("ParentLearners", fields: [parentId], references: [id])
  pathway                Pathway?                       @relation(fields: [pathwayId], references: [id])
  lmsEnrollments         LMSEnrollment[]                @relation("LMSEnrolledLearners")
  summativeResults       SummativeResult[]
  reportComments         TermlyReportComment[]          @relation("LearnerReportComments")
  valuesAssessments      ValuesAssessment[]             @relation("LearnerValues")
  meanGrades             MeanGrade[]
  unitEnrollments        UnitEnrollment[]
  unitResults            UnitResult[]
  pathwaySelections      LearnerPathwaySelection[]
  // ── LMS Digital Learning Hub ────────────────────────────────────────────────
  learningSubmissions    LearningSubmission[]           @relation("LearnerSubmissions")
  learningSessions       LearningSession[]              @relation("LearnerSessions")
  learningProgress       LearningProgress[]             @relation("LearnerLessonProgress")
  achievements           LearnerAchievement[]           @relation("LearnerAchievements")
  bookmarks              LearningBookmark[]             @relation("LearnerBookmarks")
  pathwayRecommendations LearnerPathwayRecommendation[]
  counsellorNotes        CounsellorNote[]
  schoolPreferences      LearnerSchoolPreference[]
  schoolSearchCriteria   LearnerSchoolSearchCriteria?
  selectionUnlock        PathwaySelectionUnlock?
  decisionPlan           DecisionPlan?
  actionPlan             LearnerActionPlan?
  parentComments         ParentComment[]
  counsellingSessions    CounsellingSession[]
  pathwayInterventions   PathwayIntervention[]
  schoolMatchScores      SchoolMatchScore[]
  careerMatches          LearnerCareerMatch[]
  savedCareers           LearnerCareerSave[]
  pathwayProfile         LearnerPathwayProfile?
  pathwayConversation    PathwayConversationMessage[]

  @@index([admissionNumber])
  @@index([parentId])
  @@index([primaryContactType])
  @@index([institutionType, grade, stream])
  @@index([institutionType, pathwayId])
  @@index([grade, stream])
  @@index([status])
  @@index([grade, status, archived])
  @@index([archived])
  @@map("learners")
}

model FamilyAccount {
  id           String              @id @default(uuid())
  familyCode   String              @unique @default(uuid())
  displayName  String?
  primaryPhone String?
  status       FamilyAccountStatus @default(ACTIVE)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  archived     Boolean             @default(false)
  archivedAt   DateTime?
  archivedBy   String?
  members      FamilyMember[]
  learners     LearnerFamilyLink[]

  @@index([primaryPhone])
  @@index([status, archived])
  @@map("family_accounts")
}

model FamilyMember {
  id              String             @id @default(uuid())
  familyAccountId String
  userId          String?            @unique
  name            String
  phone           String
  normalizedPhone String
  relationship    String?
  role            FamilyMemberRole   @default(GUARDIAN)
  status          FamilyMemberStatus @default(INVITED)
  isPrimary       Boolean            @default(false)
  canLogin        Boolean            @default(true)
  canPayFees      Boolean            @default(true)
  canViewReports  Boolean            @default(true)
  canReceiveSms   Boolean            @default(true)
  verifiedAt      DateTime?
  invitedById     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  familyAccount   FamilyAccount      @relation(fields: [familyAccountId], references: [id], onDelete: Cascade)
  user            User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  invitedBy       User?              @relation("FamilyMemberInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([familyAccountId, normalizedPhone])
  @@index([normalizedPhone])
  @@index([familyAccountId, isPrimary])
  @@index([status])
  @@map("family_members")
}

model LearnerFamilyLink {
  id              String        @id @default(uuid())
  familyAccountId String
  learnerId       String
  relationship    String?
  isPrimary       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  familyAccount   FamilyAccount @relation(fields: [familyAccountId], references: [id], onDelete: Cascade)
  learner         Learner       @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([familyAccountId, learnerId])
  @@index([learnerId])
  @@index([familyAccountId, isPrimary])
  @@map("learner_family_links")
}

model Pathway {
  id                       String                    @id @default(uuid())
  code                     String                    @unique
  name                     String
  description              String?
  active                   Boolean                   @default(true)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  learners                 Learner[]
  learningAreas            LearningArea[]
  categories               SubjectCategory[]
  tracks                   PathwayTrack[]
  officialLearningAreas    OfficialLearningArea[]
  combinationRules         SubjectCombinationRule[]
  learnerPathwaySelections LearnerPathwaySelection[]

  @@map("pathways")
}

model PathwayTrack {
  id                       String                    @id @default(uuid())
  pathwayId                String
  code                     String
  name                     String
  description              String?
  active                   Boolean                   @default(true)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  pathway                  Pathway                   @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  officialLearningAreas    OfficialLearningArea[]
  combinationRules         SubjectCombinationRule[]
  learnerPathwaySelections LearnerPathwaySelection[]

  @@unique([pathwayId, code])
  @@index([pathwayId])
  @@map("pathway_tracks")
}

model OfficialLearningArea {
  id               String                        @id @default(uuid())
  officialCode     String                        @unique
  officialName     String
  subjectType      SubjectType
  pathwayId        String?
  trackId          String?
  examinable       Boolean                       @default(true)
  active           Boolean                       @default(true)
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt
  pathway          Pathway?                      @relation(fields: [pathwayId], references: [id])
  track            PathwayTrack?                 @relation(fields: [trackId], references: [id])
  aliases          LearningAreaAlias[]
  combinationItems SubjectCombinationRuleItem[]
  schoolOfferings  SchoolLearningAreaOffering[]
  selectionItems   LearnerPathwaySelectionItem[]

  @@index([subjectType])
  @@index([pathwayId])
  @@index([trackId])
  @@map("official_learning_areas")
}

model LearningAreaAlias {
  id                     String               @id @default(uuid())
  officialLearningAreaId String
  alias                  String               @unique
  source                 String?
  active                 Boolean              @default(true)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  officialLearningArea   OfficialLearningArea @relation(fields: [officialLearningAreaId], references: [id], onDelete: Cascade)

  @@index([officialLearningAreaId])
  @@map("learning_area_aliases")
}

model SubjectCombinationRule {
  id             String                       @id @default(uuid())
  pathwayId      String
  trackId        String
  code           String                       @unique
  name           String
  officialSource String?
  active         Boolean                      @default(true)
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  pathway        Pathway                      @relation(fields: [pathwayId], references: [id])
  track          PathwayTrack                 @relation(fields: [trackId], references: [id])
  items          SubjectCombinationRuleItem[]
  selections     LearnerPathwaySelection[]

  @@index([pathwayId])
  @@index([trackId])
  @@map("subject_combination_rules")
}

model SubjectCombinationRuleItem {
  id                     String                 @id @default(uuid())
  ruleId                 String
  officialLearningAreaId String
  position               Int
  rule                   SubjectCombinationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  officialLearningArea   OfficialLearningArea   @relation(fields: [officialLearningAreaId], references: [id])

  @@unique([ruleId, officialLearningAreaId])
  @@index([officialLearningAreaId])
  @@map("subject_combination_rule_items")
}

model SchoolLearningAreaOffering {
  id                     String               @id @default(uuid())
  schoolId               String
  officialLearningAreaId String
  active                 Boolean              @default(true)
  capacity               Int?
  teacherCount           Int?
  notes                  String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  officialLearningArea   OfficialLearningArea @relation(fields: [officialLearningAreaId], references: [id])

  @@unique([schoolId, officialLearningAreaId])
  @@index([schoolId])
  @@index([officialLearningAreaId])
