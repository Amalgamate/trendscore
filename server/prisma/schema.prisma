  id               String           @id @default(uuid())
  invoiceNumber    String           @unique
  learnerId        String
  feeStructureId   String
  term             Term
  academicYear     Int
  dueDate          DateTime
  totalAmount      Decimal          @db.Decimal(10, 2)
  paidAmount       Decimal          @default(0) @db.Decimal(10, 2)
  balance          Decimal          @db.Decimal(10, 2)
  status           PaymentStatus    @default(PENDING)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  issuedBy         String
  archived         Boolean          @default(false)
  archivedAt       DateTime?
  archivedBy       String?
  complianceStatus ComplianceStatus @default(PENDING)
  etimsControlCode String?
  etimsQRCodeUrl   String?

  // Transport Billing
  transportBilled     Decimal  @default(0) @db.Decimal(10, 2)
  transportPaid       Decimal  @default(0) @db.Decimal(10, 2)
  transportBalance    Decimal  @default(0) @db.Decimal(10, 2)
  grossAmount         Decimal? @db.Decimal(10, 2)
  adjustmentAmount    Decimal? @db.Decimal(10, 2)
  sponsorAmount       Decimal? @db.Decimal(10, 2)
  sponsorPaidAmount   Decimal  @default(0) @db.Decimal(10, 2)
  sponsorBalance      Decimal  @default(0) @db.Decimal(10, 2)
  studentAmount       Decimal? @db.Decimal(10, 2)
  carryForwardAmount  Decimal? @db.Decimal(10, 2)
  calculationSnapshot Json?
  feeConfigurationId  String?
  revisionNumber      Int      @default(0)

  feeStructure FeeStructure         @relation(fields: [feeStructureId], references: [id])
  learner      Learner              @relation("LearnerInvoices", fields: [learnerId], references: [id], onDelete: Cascade)
  payments     FeePayment[]
  comments     FeeComment[]
  pledges      FeePledge[]
  waivers      FeeWaiver[]
  revisions    FeeInvoiceRevision[]

  @@index([learnerId])
  @@index([term, academicYear])
  @@index([status])
  @@index([dueDate])
  // Composite indexes for dashboard & fee collection hot paths
  @@index([archived, status])
  @@index([archived, transportBilled])
  @@map("fee_invoices")
}

