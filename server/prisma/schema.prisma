  suggestedValue String
  reason         String?
  evidence       String?
  source         String?
  decisionReason String?
  status         String    @default("SUBMITTED") // SUBMITTED | UNDER_REVIEW | APPROVED | REJECTED | PUBLISHED
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  school SeniorSchool @relation(fields: [schoolId], references: [id], onDelete: Cascade)

