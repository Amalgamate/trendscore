// ── Pathway Planner — Batch: Pathway Planner Phase 0 ─────────────────────────
// Replaces the raw-SQL learner_pathway_recommendations table managed by
// ensureDecisionTable() in pathway-transition-decision.service.ts.
// This model gives us type-safe Prisma queries, migrations, and Studio support.

model LearnerPathwayRecommendation {
  id                    String   @id @default(uuid())
  learnerId             String
  recommendedPathway    String // STEM | SOCIAL_SCIENCES | ARTS_SPORTS
  confidenceScore       Float    @default(0)
  learnerInterest       String?
  teacherRecommendation String?
  parentPreference      String?
  finalApprovedPathway  String?
  mismatchWarning       String?
  analysisPayload       Json?
  updatedBy             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  learner               Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([learnerId])
  @@index([learnerId, createdAt(sort: Desc)])
  @@map("learner_pathway_recommendations")
}

// Learner-owned reflection used alongside, never in place of, academic evidence.
// It keeps the "Discover Me" journey current without mutating recommendation history.
model LearnerPathwayProfile {
  id                String   @id @default(uuid())
  learnerId         String   @unique
  interestAreas     String[] @default([])
  strengthAreas     String[] @default([])
  preferredActivities String[] @default([])
  aspirations       String?
  learningPreference String?
  confidenceAreas   Json?
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())
  learner           Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
  @@map("learner_pathway_profiles")
}

// ── Pathway Planner — Phase 2/4 models ───────────────────────────────────────

model CounsellorNote {
  id         String   @id @default(uuid())
  learnerId  String
  authorId   String
  authorRole String
  note       String
  noteType   String   @default("GENERAL") // GENERAL | RECOMMENDATION | APPROVAL | CONCERN
  visibility String   @default("COUNSELLOR_ONLY") // COUNSELLOR_ONLY | SHARED_WITH_PARENT | SHARED_WITH_STUDENT
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  learner    Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  author     User     @relation("CounsellorNoteAuthor", fields: [authorId], references: [id])

  @@index([learnerId])
  @@index([authorId])
  @@map("counsellor_notes")
}

model SeniorSchool {
  id                  String                    @id @default(uuid())
  name                String
  knecCode            String?                   @unique
  county              String
  subCounty           String?
  schoolType          String                    @default("DAY") // DAY | BOARDING | DAY_AND_BOARDING
  gender              String                    @default("MIXED") // MIXED | BOYS | GIRLS
  category            String? // NATIONAL | EXTRA_COUNTY | COUNTY | SUB_COUNTY
  pathwayCodes        String[]
  trackCodes          String[]                  @default([])
  combinationCodes    String[]                  @default([])
  minimumKcpeGrade    Float?
  website             String?
  phone               String?
  active              Boolean                   @default(true)
  verified            Boolean                   @default(false)
  verificationStatus  String                    @default("UNVERIFIED") // UNVERIFIED | MINISTRY_LISTED | VERIFIED | STALE
  verifiedAt          DateTime?
  dataSource          String?
  affordabilityBand   String? // LOW | MEDIUM | HIGH
  faithAffiliation    String?
  facilities          String[]                  @default([])
  clubs               String[]                  @default([])
  specialNeedsSupport String[]                  @default([])
  annualCostNotes     String?
  performanceNotes    String?
  transitionNotes     String?
  latitude            Float?
  longitude           Float?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  preferences         LearnerSchoolPreference[]
