model CounsellingSession {
  id                 String    @id @default(uuid())
  learnerId          String
  counsellorId       String?
  scheduledAt        DateTime?
  durationMinutes    Int?      @default(30)
  mode               String    @default("IN_PERSON") // IN_PERSON | VIRTUAL | PHONE
  status             String    @default("SCHEDULED") // REQUESTED | SCHEDULED | COMPLETED | CANCELLED | NO_SHOW | FOLLOW_UP_REQUIRED
