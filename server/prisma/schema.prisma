  app       App   @relation(fields: [appId], references: [id], onDelete: Cascade)
  updatedBy User? @relation("AppConfigUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([schoolId, appId])
  @@index([schoolId])
  @@index([appId])
  @@map("school_app_configs")
