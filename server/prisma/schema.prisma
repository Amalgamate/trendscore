  @@unique([learnerId, schoolId])
  @@index([learnerId])
  @@map("learner_school_preferences")
}

// Structured search criteria the parent/learner give for senior school
// selection — distinct from LearnerSchoolPreference (which ranks specific
// chosen schools). One row per learner. Feeds the future fit-scoring engine
// (SPEC-004); no matching SeniorSchool fields exist yet for budgetBand or
// faithAffiliation, so those are collected now for later use.
model LearnerSchoolSearchCriteria {
  id                 String   @id @default(uuid())
  learnerId          String   @unique
  budgetBand         String? // LOW | MEDIUM | HIGH
  boardingPreference String? // DAY | BOARDING | EITHER
  preferredCounties  String[] @default([])
  faithPreference    String?
  notes              String?
  boardingRequired   Boolean  @default(false)
  countyRequired     Boolean  @default(false)
  requiredSupport    String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  learner            Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@map("learner_school_search_criteria")
}

// ── Pathway Planner — Stage 1 foundational models (Decision Plan, action
// items, parent comments, counselling sessions, school match scores and
// corrections). See PATHWAYS_IMPLEMENTATION_PLAN.md for the SPEC mapping.

enum DecisionPlanStatus {
  DRAFT
  SUBMITTED
  PARENT_REVIEWED
  COUNSELLOR_REVIEWED
  REVISION_REQUIRED
  APPROVED
  LOCKED
}

// Aggregates a learner's overall senior-pathway decision (pathway + subject
// combination + school choices) through a review lifecycle distinct from
// LearnerPathwaySelection, which only tracks subject-combination approval.
model DecisionPlan {
  id                     String             @id @default(uuid())
  learnerId              String             @unique
  status                 DecisionPlanStatus @default(DRAFT)
  version                Int                @default(0)
  submittedAt            DateTime?
  submittedById          String?
  parentReviewedAt       DateTime?
  parentReviewedById     String?
  counsellorReviewedAt   DateTime?
  counsellorReviewedById String?
  approvedAt             DateTime?
  approvedById           String?
  lockedAt               DateTime?
  lockedById             String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  learner     Learner                  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  actionPlan  LearnerActionPlan?
  comments    ParentComment[]
  submissions DecisionPlanSubmission[]
  revisions   DecisionPlanRevision[]

  @@index([learnerId])
  @@index([status])
  @@map("decision_plans")
}

model PathwayConversationMessage {
  id         String   @id @default(uuid())
  learnerId  String
  authorId   String
  authorName String
  authorRole String
  message    String
  createdAt  DateTime @default(now())
  learner    Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([learnerId, createdAt])
  @@map("pathway_conversation_messages")
}

// Immutable copy of the learner's selected pathway, combination, careers and
// schools at each submission. A revision creates a new version rather than
// overwriting the evidence reviewed by parents and counsellors.
model DecisionPlanSubmission {
  id             String       @id @default(uuid())
  decisionPlanId String
  version        Int
  snapshot       Json
  submittedById  String
  submittedAt    DateTime     @default(now())
  decisionPlan   DecisionPlan @relation(fields: [decisionPlanId], references: [id], onDelete: Cascade)

  @@unique([decisionPlanId, version])
  @@index([decisionPlanId, submittedAt(sort: Desc)])
  @@map("decision_plan_submissions")
}

model DecisionPlanRevision {
  id              String       @id @default(uuid())
  decisionPlanId  String
  reasonCategory  String
  explanation     String
  affectedSection String
  requiredAction  String
  dueDate         DateTime?
  requestedById   String
  requestedByRole String
  resolvedAt      DateTime?
  createdAt       DateTime     @default(now())
  decisionPlan    DecisionPlan @relation(fields: [decisionPlanId], references: [id], onDelete: Cascade)

  @@index([decisionPlanId, createdAt(sort: Desc)])
  @@index([resolvedAt])
  @@map("decision_plan_revisions")
}

model LearnerActionPlan {
  id             String   @id @default(uuid())
  learnerId      String   @unique
  decisionPlanId String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  learner      Learner       @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  decisionPlan DecisionPlan? @relation(fields: [decisionPlanId], references: [id])
  items        ActionItem[]

  @@map("learner_action_plans")
}

model ActionItem {
  id             String    @id @default(uuid())
  actionPlanId   String
  title          String
  description    String?
  assignedToRole String    @default("STUDENT") // STUDENT | PARENT | COUNSELLOR
  status         String    @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED
  priority       String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  category       String?
  dueDate        DateTime?
  completedAt    DateTime?
  completionNote String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  actionPlan LearnerActionPlan @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)

  @@index([actionPlanId])
  @@index([status])
  @@map("action_items")
}

model ParentComment {
  id             String   @id @default(uuid())
  learnerId      String
  decisionPlanId String?
  authorId       String
  body           String
  visibility     String   @default("COUNSELLOR_ONLY") // COUNSELLOR_ONLY | SHARED_WITH_STUDENT
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  learner      Learner       @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  decisionPlan DecisionPlan? @relation(fields: [decisionPlanId], references: [id])
  author       User          @relation("ParentCommentAuthor", fields: [authorId], references: [id])

  @@index([learnerId])
  @@index([decisionPlanId])
