  reorderLevel     Decimal                @default(0) @db.Decimal(10, 2)
  isActive         Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  fixedAssets      FixedAsset[]
  category         InventoryCategory?     @relation(fields: [categoryId], references: [id])
  movements        StockMovement[]
  requisitionItems StockRequisitionItem[]

  @@index([sku])
  @@map("inventory_items")
}

model StockMovement {
  id            String            @id @default(uuid())
  itemId        String
  fromStoreId   String?
  toStoreId     String?
  quantity      Decimal           @db.Decimal(10, 2)
  type          StockMovementType
  reference     String?
  description   String?
  performedById String?
  date          DateTime          @default(now())
  createdAt     DateTime          @default(now())
  fromStore     InventoryStore?   @relation("FromStore", fields: [fromStoreId], references: [id])
  item          InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  toStore       InventoryStore?   @relation("ToStore", fields: [toStoreId], references: [id])

  @@index([itemId])
  @@index([fromStoreId])
  @@index([toStoreId])
  @@index([date])
  @@map("stock_movements")
}

model StockRequisition {
  id            String                 @id @default(uuid())
  requisitionNo String                 @unique
  requestedById String
  department    String?
  priority      String                 @default("NORMAL")
  status        RequisitionStatus      @default(PENDING)
  notes         String?
  requiredDate  DateTime?
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  items         StockRequisitionItem[]
  approvedBy    User?                  @relation("ApprovedBy", fields: [approvedById], references: [id])
  requestedBy   User                   @relation("RequestedBy", fields: [requestedById], references: [id])

  @@index([status])
  @@map("stock_requisitions")
}

model StockRequisitionItem {
  id            String           @id @default(uuid())
  requisitionId String
  itemId        String
  quantity      Decimal          @db.Decimal(10, 2)
  fulfilledQty  Decimal          @default(0) @db.Decimal(10, 2)
  item          InventoryItem    @relation(fields: [itemId], references: [id])
  requisition   StockRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  @@map("stock_requisition_items")
}

model FixedAsset {
  id             String            @id @default(uuid())
  assetCode      String            @unique
  itemId         String?
  name           String
  description    String?
  serialNumber   String?
  model          String?
  manufacturer   String?
  purchaseDate   DateTime?
  purchaseCost   Decimal?          @db.Decimal(15, 2)
  warrantyExpiry DateTime?
  condition      AssetCondition    @default(NEW)
  location       String?
  currentStoreId String?
  status         String            @default("ACTIVE")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  assignments    AssetAssignment[]
  currentStore   InventoryStore?   @relation(fields: [currentStoreId], references: [id])
  item           InventoryItem?    @relation(fields: [itemId], references: [id])

  @@index([assetCode])
  @@map("fixed_assets")
}

model AssetAssignment {
  id                  String          @id @default(uuid())
  assetId             String
  assignedToId        String?
  assignedToClassId   String?
  assignedAt          DateTime        @default(now())
  expectedReturn      DateTime?
  returnedAt          DateTime?
  conditionOnAssigned AssetCondition
  conditionOnReturned AssetCondition?
  notes               String?
  asset               FixedAsset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assignedToClass     Class?          @relation("AssetClass", fields: [assignedToClassId], references: [id])
  assignedTo          User?           @relation("AssetUser", fields: [assignedToId], references: [id])

  @@index([assetId])
  @@map("asset_assignments")
}

model SchemeOfWork {
  id            String             @id @default(uuid())
  teacherId     String
  grade         String
  learningArea  String
  term          Term
  academicYear  Int
  classId       String?
  title         String?
  status        SoWStatus          @default(DRAFT)
  reviewedBy    String?
  reviewedAt    DateTime?
  reviewComment String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  archived      Boolean            @default(false)
  weeks         SchemeOfWorkWeek[]
  teacher       User               @relation("TeacherSchemes", fields: [teacherId], references: [id])

  @@unique([teacherId, grade, learningArea, term, academicYear])
  @@unique([teacherId, grade, learningArea, term, academicYear], map: "schemes_of_work_teacherId_grade_learningArea_term_academic_key")
  @@index([grade, term, academicYear])
  @@index([teacherId])
  @@index([status])
  @@map("schemes_of_work")
}

model SchemeOfWorkWeek {
  id               String       @id @default(uuid())
  schemeId         String
  weekNumber       Int
  strand           String?
  subStrand        String?
  outcomes         String?
  inquiryQuestions String?
  activities       String?
  coreCompetencies String?
  values           String?
  pertinentIssues  String?
  resources        String?
  assessment       String?
  remarks          String?
  scheme           SchemeOfWork @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@unique([schemeId, weekNumber])
  @@index([schemeId])
  @@map("scheme_of_work_weeks")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  userId    String?
  userEmail String?
  userRole  String?
  ipAddress String?
  method    String
  path      String
  params    String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

model BiometricDevice {
  id        String         @id @default(uuid())
  name      String
  deviceId  String         @unique
  type      String         @default("TERMINAL")
  location  String?
  ipAddress String?
  status    String         @default("OFFLINE")
  lastSeen  DateTime?
  token     String         @unique @default(uuid())
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  logs      BiometricLog[]

  @@map("biometric_devices")
}

model BiometricCredential {
  id          String   @id @default(uuid())
  userId      String?
  learnerId   String?
  type        String   @default("FINGERPRINT")
  template    String
  fingerIndex Int?
  quality     Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  learner     Learner? @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([learnerId])
  @@map("biometric_credentials")
}

model BiometricLog {
  id           String          @id @default(uuid())
  deviceId     String
  personId     String
  personType   String
  timestamp    DateTime
  direction    String          @default("IN")
  status       String          @default("PENDING")
  errorMessage String?
  device       BiometricDevice @relation(fields: [deviceId], references: [id])

  @@index([deviceId])
  @@index([status])
  @@index([timestamp])
  @@map("biometric_logs")
}

model TransportVehicle {
  id                 String           @id @default(uuid())
  registrationNumber String           @unique
  capacity           Int
  driverName         String
  driverPhone        String?
  status             String           @default("ACTIVE")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  archived           Boolean          @default(false)
  routes             TransportRoute[]

  @@map("transport_vehicles")
}

model TransportRoute {
  id          String                @id @default(uuid())
  name        String
  description String?
  amount      Decimal               @default(0.00) @db.Decimal(10, 2)
  vehicleId   String?
  status      String                @default("ACTIVE")
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  archived    Boolean               @default(false)
  assignments TransportAssignment[]
  vehicle     TransportVehicle?     @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@map("transport_routes")
}

model TransportAssignment {
  id            String         @id @default(uuid())
  routeId       String
  passengerId   String
  passengerType String         @default("LEARNER")
  pickupPoint   String?
  dropoffPoint  String?
  status        String         @default("ACTIVE")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  archived      Boolean        @default(false)
  route         TransportRoute @relation(fields: [routeId], references: [id])

  @@index([routeId])
  @@index([passengerId])
  @@map("transport_assignments")
}

model LMSCourse {
  id             String          @id @default(uuid())
  title          String
  description    String?
  subject        String
  grade          String
  category       String
  status         CourseStatus    @default(DRAFT)
  createdById    String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  archived       Boolean         @default(false)
  // ── LMS Digital Learning Hub extensions (task 1.3) ──────────────────────
  termId         String?
  classId        String?
  learningAreaId String?
  publishedAt    DateTime?
  lessonCount    Int?            @default(0)
  content        LMSContent[]
  createdBy      User            @relation("LMSCreatedCourses", fields: [createdById], references: [id])
  enrollments    LMSEnrollment[]

  @@index([createdById])
  @@index([subject])
  @@index([grade])
  @@index([status])
  @@map("lms_courses")
}

model LMSContent {
  id           String        @id @default(uuid())
  courseId     String
  title        String
  description  String?
  type         ContentType
  url          String
  duration     Int?
  fileSize     Int?
  order        Int           @default(1)
  uploadedById String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  archived     Boolean       @default(false)
  // ── LMS Digital Learning Hub extensions (task 1.3) ──────────────────────
  resourceType String?
  topic        String?
  difficulty   String?
  language     String?       @default("English")
  course       LMSCourse     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploadedBy   User          @relation("LMSUploadedContent", fields: [uploadedById], references: [id])
  progress     LMSProgress[]

  @@index([courseId])
  @@index([uploadedById])
  @@index([type])
  @@map("lms_content")
}

model LMSEnrollment {
  id           String           @id @default(uuid())
  courseId     String
  learnerId    String
  enrolledById String
  status       EnrollmentStatus @default(ACTIVE)
  enrolledAt   DateTime         @default(now())
  unenrolledAt DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  archived     Boolean          @default(false)
  course       LMSCourse        @relation(fields: [courseId], references: [id])
  enrolledBy   User             @relation("LMSEnrolledBy", fields: [enrolledById], references: [id])
  learner      Learner          @relation("LMSEnrolledLearners", fields: [learnerId], references: [id])
  progress     LMSProgress[]

  @@unique([courseId, learnerId])
  @@index([courseId])
  @@index([learnerId])
  @@index([enrolledById])
  @@index([status])
  @@map("lms_enrollments")
}

model LMSProgress {
  id             String        @id @default(uuid())
  enrollmentId   String
  contentId      String
  completed      Boolean       @default(false)
  progress       Int           @default(0)
  timeSpent      Int           @default(0)
  lastAccessedAt DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  content        LMSContent    @relation(fields: [contentId], references: [id], onDelete: Cascade)
  enrollment     LMSEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, contentId])
  @@index([enrollmentId])
  @@index([contentId])
  @@map("lms_progress")
}

model AIGeneratedContent {
  id         String        @id @default(cuid())
  schoolId   String
  type       AIContentType
  entityId   String
  entityType String
  content    String        @db.Text
  prompt     String?       @db.Text
  provider   String?
  tokensUsed Int?
  createdBy  String
  createdAt  DateTime      @default(now())
  archived   Boolean       @default(false)
  school     School        @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([type])
  @@index([entityType, entityId])
  @@index([createdBy])
  @@index([createdAt])
  @@index([archived])
  @@map("ai_generated_content")
}

// ─── LMS DIGITAL LEARNING HUB MODELS ────────────────────────────────────────

// ─── LESSON BUILDER ──────────────────────────────────────────────────────────

model LearningLesson {
  id             String       @id @default(uuid())
  schoolId       String
  courseId       String? // optional link to existing LMSCourse
  learningAreaId String // FK → LearningArea
  classId        String // FK → Class
  streamId       String? // optional FK → Stream
  termId         String // FK → TermConfig
  title          String
  description    String?      @db.Text
  coverImageUrl  String?
  estimatedMins  Int?
  status         LessonStatus @default(DRAFT)
  publishedAt    DateTime?
  allowComments  Boolean      @default(true)
  allowDownload  Boolean      @default(false)
  allowQuestions Boolean      @default(true)
  createdById    String // FK → User
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  archived       Boolean      @default(false)

  school       School             @relation(fields: [schoolId], references: [id])
  learningArea LearningArea       @relation(fields: [learningAreaId], references: [id])
  class        Class              @relation(fields: [classId], references: [id])
  blocks       LessonBlock[]
  sessions     LearningSession[]
  progress     LearningProgress[]
  createdBy    User               @relation("LessonCreator", fields: [createdById], references: [id])

  @@index([schoolId])
  @@index([classId])
  @@index([learningAreaId])
  @@index([status])
  @@index([termId])
  @@index([schoolId, classId, learningAreaId])
  @@map("learning_lessons")
}

model LessonBlock {
  id        String          @id @default(uuid())
  lessonId  String
  type      LessonBlockType
  order     Int
  content   Json // flexible block payload (text, url, quiz data, etc.)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  archived  Boolean         @default(false)

  lesson LearningLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@index([type])
  @@map("lesson_blocks")
}

// ─── ASSIGNMENT SYSTEM ───────────────────────────────────────────────────────

model LearningAssignment {
  id               String             @id @default(uuid())
  schoolId         String
  learningAreaId   String
  classId          String
  streamId         String?
  termId           String
  title            String
  instructions     String?            @db.Text
  category         AssignmentCategory
  status           AssignmentStatus   @default(DRAFT)
  dueDate          DateTime?
  estimatedMins    Int?
  totalMarks       Int?
  passMark         Int?
  rubric           Json? // structured rubric definition
  cbcOutcomes      String[]           @default([]) // CBC outcome IDs
  allowLateSubmit  Boolean            @default(true)
  allowResubmit    Boolean            @default(false)
  maxFileSize      Int                @default(25) // MB
  allowedFileTypes String[]           @default([])
  gradebookSync    Boolean            @default(false) // sync marks to assessments module
  publishedAt      DateTime?
  createdById      String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  archived         Boolean            @default(false)

  school       School               @relation(fields: [schoolId], references: [id])
  learningArea LearningArea         @relation(fields: [learningAreaId], references: [id])
  class        Class                @relation(fields: [classId], references: [id])
  files        AssignmentFile[]
  submissions  LearningSubmission[]
  createdBy    User                 @relation("AssignmentCreator", fields: [createdById], references: [id])

  @@index([schoolId])
  @@index([classId])
  @@index([learningAreaId])
  @@index([status])
  @@index([dueDate])
  @@index([termId])
  @@index([schoolId, classId, status, dueDate])
  @@map("learning_assignments")
}

model AssignmentFile {
  id           String   @id @default(uuid())
  assignmentId String
  name         String
  url          String
  fileType     String
  fileSize     Int?
  createdAt    DateTime @default(now())

  assignment LearningAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@map("assignment_files")
}

model LearningSubmission {
  id            String           @id @default(uuid())
  assignmentId  String
  learnerId     String
  status        SubmissionStatus @default(DRAFT)
  content       String?          @db.Text // rich text answer
  marks         Float?
  feedback      String?          @db.Text
  isLate        Boolean          @default(false)
  attemptNumber Int              @default(1)
  submittedAt   DateTime?
  markedAt      DateTime?
  markedById    String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  archived      Boolean          @default(false)

  assignment LearningAssignment @relation(fields: [assignmentId], references: [id])
  learner    Learner            @relation("LearnerSubmissions", fields: [learnerId], references: [id])
  markedBy   User?              @relation("SubmissionMarker", fields: [markedById], references: [id])
  files      SubmissionFile[]

  @@unique([assignmentId, learnerId, attemptNumber])
  @@index([assignmentId])
  @@index([learnerId])
  @@index([status])
  @@index([markedById])
  @@map("learning_submissions")
}

model SubmissionFile {
  id           String   @id @default(uuid())
  submissionId String
  name         String
  url          String
  fileType     String
  fileSize     Int?
  createdAt    DateTime @default(now())

  submission LearningSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("submission_files")
}

// ─── REVISION LIBRARY ────────────────────────────────────────────────────────

model LearningResource {
  id             String           @id @default(uuid())
  schoolId       String
  learningAreaId String
  classId        String?
  title          String
  description    String?          @db.Text
  resourceType   ResourceType
  fileUrl        String?
  externalUrl    String?
  thumbnailUrl   String?
  fileSize       Int?
  fileType       String?
  topic          String?
  term           Int? // 1, 2, 3
  year           Int?
  difficulty     DifficultyLevel?
  language       String           @default("English")
  tags           String[]         @default([])
  downloadCount  Int              @default(0)
  viewCount      Int              @default(0)
  isPublic       Boolean          @default(false) // visible outside school
  uploadedById   String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  archived       Boolean          @default(false)

  school              School               @relation(fields: [schoolId], references: [id])
  learningArea        LearningArea         @relation(fields: [learningAreaId], references: [id])
  class               Class?               @relation(fields: [classId], references: [id])
  uploadedBy          User                 @relation("ResourceUploader", fields: [uploadedById], references: [id])
  marketplaceListings MarketplaceListing[]
  bookmarks           LearningBookmark[]

  @@index([schoolId])
  @@index([learningAreaId])
  @@index([classId])
  @@index([resourceType])
  @@index([topic])
  @@index([uploadedById])
  @@map("learning_resources")
}

// ─── MARKETPLACE (Enterprise) ────────────────────────────────────────────────

model MarketplaceListing {
  id                String                 @id @default(uuid())
  schoolId          String
  resourceId        String
  sellerId          String
  title             String
  description       String?                @db.Text
  price             Float                  @default(0) // 0 = free
  currency          String                 @default("KES")
  listingType       MarketplaceListingType
  revenueSharePct   Float                  @default(70) // seller's share %
  status            MarketplaceStatus      @default(PENDING_APPROVAL)
  approvalRequestId String?
  rating            Float?
  ratingCount       Int                    @default(0)
  downloadCount     Int                    @default(0)
  purchaseCount     Int                    @default(0)
  publishedAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  archived          Boolean                @default(false)

  school    School                @relation(fields: [schoolId], references: [id])
  resource  LearningResource      @relation(fields: [resourceId], references: [id])
  seller    User                  @relation("MarketplaceSeller", fields: [sellerId], references: [id])
  purchases MarketplacePurchase[]

  @@index([schoolId])
  @@index([sellerId])
  @@index([status])
  @@index([listingType])
  @@index([price])
  @@map("marketplace_listings")
}

model MarketplacePurchase {
  id              String         @id @default(uuid())
  listingId       String
  buyerId         String
  schoolId        String
  amount          Float
  currency        String         @default("KES")
  mpesaReceiptNo  String?
  transactionId   String?
  sellerEarnings  Float
  platformFee     Float
  status          PurchaseStatus @default(PENDING)
  downloadCount   Int            @default(0)
  maxDownloads    Int            @default(5)
  accessExpiresAt DateTime?
  purchasedAt     DateTime       @default(now())
  createdAt       DateTime       @default(now())

  listing MarketplaceListing @relation(fields: [listingId], references: [id])
  buyer   User               @relation("MarketplaceBuyer", fields: [buyerId], references: [id])

  @@index([listingId])
  @@index([buyerId])
  @@index([schoolId])
  @@index([status])
  @@map("marketplace_purchases")
}

// ─── PROGRESS & GAMIFICATION ─────────────────────────────────────────────────

model LearningProgress {
  id              String    @id @default(uuid())
  learnerId       String
  lessonId        String
  schoolId        String
  blocksCompleted Int       @default(0)
  totalBlocks     Int       @default(0)
  percentComplete Float     @default(0)
  timeSpentMins   Int       @default(0)
  lastBlockId     String?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  learner Learner        @relation("LearnerLessonProgress", fields: [learnerId], references: [id])
  lesson  LearningLesson @relation(fields: [lessonId], references: [id])

  @@unique([learnerId, lessonId])
  @@index([learnerId])
  @@index([lessonId])
  @@index([schoolId])
  @@map("learning_progress")
}

model LearningSession {
  id          String    @id @default(uuid())
  learnerId   String
  lessonId    String
  schoolId    String
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  durationSec Int?
  deviceType  String? // mobile | desktop | tablet
  createdAt   DateTime  @default(now())

  learner Learner        @relation("LearnerSessions", fields: [learnerId], references: [id])
  lesson  LearningLesson @relation(fields: [lessonId], references: [id])

  @@index([learnerId])
  @@index([lessonId])
  @@index([schoolId])
  @@index([startedAt])
  @@map("learning_sessions")
}

model LearnerAchievement {
  id          String          @id @default(uuid())
  learnerId   String
  schoolId    String
  type        AchievementType
  title       String
  description String?
  xpEarned    Int             @default(0)
  metadata    Json?
  earnedAt    DateTime        @default(now())
  createdAt   DateTime        @default(now())
  archived    Boolean         @default(false)

  learner Learner @relation("LearnerAchievements", fields: [learnerId], references: [id])

  @@index([learnerId])
  @@index([schoolId])
  @@index([type])
  @@map("learner_achievements")
}

model LearningBookmark {
  id         String   @id @default(uuid())
  learnerId  String
  resourceId String?
  lessonId   String?
  schoolId   String
  createdAt  DateTime @default(now())
  archived   Boolean  @default(false)

  learner  Learner           @relation("LearnerBookmarks", fields: [learnerId], references: [id])
  resource LearningResource? @relation(fields: [resourceId], references: [id])

  @@unique([learnerId, resourceId])
  @@index([learnerId])
  @@index([schoolId])
  @@map("learning_bookmarks")
}

model LMSSettings {
  id                     String   @id @default(uuid())
  schoolId               String   @unique
  enableLearning         Boolean  @default(true)
  enableMarketplace      Boolean  @default(false)
  enableAI               Boolean  @default(false)
  enableRevisionLibrary  Boolean  @default(true)
  allowLateSubmission    Boolean  @default(true)
  allowResubmission      Boolean  @default(false)
  maxUploadSizeMB        Int      @default(25)
  allowedFileTypes       String[] @default([])
  assignmentDueTime      String   @default("23:59")
  enableComments         Boolean  @default(true)
  enableStudentQuestions Boolean  @default(true)
  enableDownloads        Boolean  @default(true)
  enableGamification     Boolean  @default(false)
  enableXP               Boolean  @default(false)
  enableBadges           Boolean  @default(false)
  enableLeaderboards     Boolean  @default(false)
  enableStreaks          Boolean  @default(false)
  notifyParents          Boolean  @default(true)
  showFeedbackToParents  Boolean  @default(true)
  showProgressToParents  Boolean  @default(true)
