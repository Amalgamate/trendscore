"SlaNB/mm2w"},sshDisconnected:{defaultMessage:"Lost connection to {host}",id:"x/AANGatCX"},rewindTargetNotFound:{defaultMessage:"Couldn't rewind",id:"qz07ubuWTz"},gitCheckoutFailed:{defaultMessage:"Couldn't switch branches",id:"5qlmjg4fJG"},remoteWorktreeFailed:{defaultMessage:"Couldn't set up remote folder",id:"yyIEWowL6r"},policyDenied:{defaultMessage:"Folder not allowed by your organization",id:"NxWkpRIOP4"},binaryLocked:{defaultMessage:"Locked by another program",id:"Jj5UsNkTxk"}}),jTt=G({tryAgain:{defaultMessage:"Try sending your message again.",id:"0hzmTPDdkC"},tryAgainOrReport:{defaultMessage:"Try sending your message again. If it keeps happening, share feedback so we can investigate.",id:"wSIy1+/HLg"},reinstall:{defaultMessage:"The Claude Code binary is missing or damaged. Reinstall Claude Desktop to continue.",id:"E9ffNa95kd"},reinstallArch:{defaultMessage:"The Claude Code binary doesn't match this computer's architecture. Reinstall Claude Desktop for your platform.",id:"hZ2DipvK2w"},restartApp:{defaultMessage:"Restarting Claude Desktop may resolve this.",id:"B6F2sC7pVE"},signIn:{defaultMessage:"Sign in again to continue.",id:"p0Vi703w32"},githubAuth:{defaultMessage:"Your GitHub credentials were rejected. Reconnect GitHub to continue.",id:"1HLmdzwR9I"},rateLimit:{defaultMessage:"You've reached your usage limit. Try again after your limit resets.",id:"HfMQVThKYy"},network:{defaultMessage:"Check your internet connection, VPN, or proxy and try again.",id:"Wb/3E+ALRw"},connectionRefused:{defaultMessage:"Check that your SSH host or local proxy is reachable, then try again.",id:"whFH9beKiB"},resumeNotFound:{defaultMessage:"The previous transcript couldn't be found on disk. Send your message again — it will start a fresh session.",id:"g5WkoXEVnb"},folderNotFound:{defaultMessage:"This session's working folder no longer exists. Choose a different folder or start a new session.",id:"21CV5Tczjm"},folderAccessDenied:{defaultMessage:"Claude can't read this folder. Grant access in System Settings → Privacy & Security → Files and Folders.",id:"hIatmGaemL"},gitRequired:{defaultMessage:"Install Git (Xcode Command Line Tools on macOS, Git for Windows on Windows) to continue.",id:"SuGpwv1fKH"},endpointSecurity:{defaultMessage:"Your endpoint-security software blocked Claude Code. Ask your IT team to allowlist signing Team ID Q6L2SF6YDW.",id:"k6ld7Mp5ii"},appControlBlocked:{defaultMessage:"WDAC, AppLocker, or endpoint protection is preventing the workspace runtime from starting. Copy the details for the binary path and policy rule needed to allowlist it.",id:"Y0/NpCBqzJ"},osTooOld:{defaultMessage:"Claude Code requires a newer version of macOS. Update macOS to continue.",id:"KtH0oCK2rM"},dllNotFound:{defaultMessage:"A Windows system library is missing. Reinstall Claude Desktop or repair the Visual C++ Redistributable.",id:"KTSbDsrJwt"},diskError:{defaultMessage:"Reading or writing the session folder failed. Check disk space and permissions, then try again.",id:"JkbN+kWYy3"},unexpectedOutput:{defaultMessage:"A shell hook or tool wrote unexpected output. Check your shell startup files and Claude Code hooks for stray stdout writes.",id:"bmH8vfWbiu"},trustRequired:{defaultMessage:"Approve this folder in the trust prompt to continue.",id:"DZwrOk9TjA"},nestedSession:{defaultMessage:"Claude Code can't run inside another Claude Code session. Close the outer session to continue.",id:"U8DVwUsvy2"},otelExporter:{defaultMessage:"An OTEL console exporter in settings.json is interfering with Claude Code. Remove the OTEL_*_EXPORTER=console setting.",id:"lY2D3mXwpE"},bridgeOffline:{defaultMessage:"Your terminal's Claude Code session stopped responding. Check your terminal for errors, then resend your message.",id:"zaPxGqzW4A"},sshDisconnected:{defaultMessage:"The SSH connection dropped and auto-reconnect didn't succeed. Your session is preserved on the remote host — resend your message to reconnect and pick up where you left off. If it keeps failing, check that the host is reachable (VPN, network) and your SSH agent is unlocked.",id:"RtSXJpna/C"},rewindTargetNotFound:{defaultMessage:"That point in the conversation couldn't be found. Send your message again to continue the session.",id:"pPg+NzFStg"},gitCheckoutFailed:{defaultMessage:"Commit or stash changes, or check your repository for issues like a missing branch, locked files, or Git LFS setup.",id:"nZAVyUccg2"},remoteWorktreeFailed:{defaultMessage:"Check disk space and the repository on that machine, then try again.",id:"sThS3jTs5d"},policyDenied:{defaultMessage:"Your organization's policy has blocked access to this folder. Choose a folder inside an allowed workspace, or contact your IT team.",id:"/zBewcOy3f"},binaryLocked:{defaultMessage:"Another program (e.g. antivirus) has a temporary lock on app files. Wait a moment and try again.",id:"4w2mdIEQf/"}}),MTt={sdk_binary_missing:{title:_Tt.cliCouldntStart,body:jTt.reinstall,retryHelps:!1},sdk_binary_arch_mismatch:{title:_Tt.cliCouldntStart,body:jTt.reinstallArch,retryHelps:!1},sdk_binary_corrupt:{title:_Tt.cliCouldntStart,body:jTt.tryAgain,retryHelps:!0},disclaimer_binary_missing:{title:_Tt.cliCouldntStart,body:jTt.reinstall,retryHelps:!1},spawn_failed:{title:_Tt.cliCouldntStart,body:jTt.restartApp,retryHelps:!0},segfault:{title:_Tt.cliCrashed,body:jTt.tryAgainOrReport,retryHelps:!0},process_crashed:{title:_Tt.cliCrashed,body:jTt.tryAgainOrReport,retryHelps:!0},renderer_cascade:{title:_Tt.interrupted,body:jTt.tryAgain,retryHelps:!0},process_interrupted:{title:_Tt.interrupted,body:jTt.tryAgain,retryHelps:!0},endpoint_security_blocked:{title:_Tt.endpointSecurity,body:jTt.endpointSecurity,retryHelps:!1},app_control_blocked:{title:_Tt.appControlBlocked,body:jTt.appControlBlocked,retryHelps:!1,copyDetails:'Claude\'s workspace runtime failed to start with errno -4094 (spawn UNKNOWN).\n\nThis is usually WDAC, AppLocker, or antivirus/endpoint protection blocking execution of the runtime binary, which is downloaded under the user profile:\n\n  %LOCALAPPDATA%\\Claude-3p\\claude-code\\<version>\\claude.exe   (third-party deployment)\n  %APPDATA%\\Claude\\claude-code\\<version>\\claude.exe           (standard deployment)\n\nThe runtime also spawns ripgrep (rg.exe) from the same directory.\n\nTo confirm which control is blocking it, check Event Viewer:\n  - WDAC:       Applications and Services Logs > Microsoft > Windows > CodeIntegrity > Operational, Event ID 3077\n  - AppLocker:  Applications and Services Logs > Microsoft > Windows > AppLocker > EXE and DLL, Event ID 8004\n  - Defender:   Applications and Services Logs > Microsoft > Windows > Windows Defender > Operational, Event ID 1116 / 1117\n\nTo fix, add a publisher rule for "Anthropic, PBC" to the WDAC or AppLocker policy applied to this device. The binary is code-signed (verify with: Get-AuthenticodeSignature on claude.exe), so a publisher rule covers all install modes and version updates.\n\nIf publisher rules aren\'t available, add a path rule instead:\n  - AppLocker (3P):  %OSDRIVE%\\Users\\*\\AppData\\Local\\Claude-3p\\claude-code\\*\n  - AppLocker (1P):  %OSDRIVE%\\Users\\*\\AppData\\Roaming\\Claude\\claude-code\\*\n  - WDAC (3P):       %OSDRIVE%\\Users\\*\\AppData\\Local\\Claude-3p\\claude-code\\*\n  - WDAC (1P):       %OSDRIVE%\\Users\\*\\AppData\\Roaming\\Claude\\claude-code\\*\n    Note: WDAC ignores FilePath rules to user-writable locations unless the policy sets "Disabled:Runtime FilePath Rule Protection".\n\nIf Defender or other antivirus is blocking it, add an exclusion for the directory above or allow the detected item.'},cli_fastfail:{title:_Tt.cliCrashed,body:jTt.tryAgainOrReport,retryHelps:!0},cli_shutdown_crash_benign:{title:_Tt.interrupted,body:jTt.tryAgain,retryHelps:!0},dll_not_found:{title:_Tt.dllNotFound,body:jTt.dllNotFound,retryHelps:!1},bun_crash:{title:_Tt.cliCrashed,body:jTt.tryAgainOrReport,retryHelps:!0},auth_error:{title:_Tt.signedOut,body:jTt.signIn,retryHelps:!1},github_auth:{title:_Tt.githubAuth,body:jTt.githubAuth,retryHelps:!1},rate_limit:{title:_Tt.rateLimit,body:jTt.rateLimit,retryHelps:!0},network_error:{title:_Tt.network,body:jTt.network,retryHelps:!0},connection_refused:{title:_Tt.connectionRefused,body:jTt.connectionRefused,retryHelps:!0},json_parse_error:{title:_Tt.unexpectedOutput,body:jTt.restartApp,retryHelps:!0},filesystem_error:{title:_Tt.diskError,body:jTt.diskError,retryHelps:!0},cli_stdout_pollution:{title:_Tt.unexpectedOutput,body:jTt.unexpectedOutput,retryHelps:!1},cli_resume_not_found:{title:_Tt.resumeNotFound,body:jTt.resumeNotFound,retryHelps:!0},stream_ended_no_result:{title:_Tt.noResponse,body:jTt.tryAgain,retryHelps:!0},git_not_found:{title:_Tt.gitRequired,body:jTt.gitRequired,retryHelps:!1},cwd_not_found:{title:_Tt.folderNotFound,body:jTt.folderNotFound,retryHelps:!1},timeout:{title:_Tt.noResponse,body:jTt.tryAgain,retryHelps:!0},trust_required:{title:_Tt.trustRequired,body:jTt.trustRequired,retryHelps:!0},bun_cwd_eperm:{title:_Tt.folderAccessDenied,body:jTt.folderAccessDenied,retryHelps:!1},os_too_old:{title:_Tt.osTooOld,body:jTt.osTooOld,retryHelps:!1},claudecode_nested:{title:_Tt.nestedSession,body:jTt.nestedSession,retryHelps:!1},otel_console_exporter:{title:_Tt.otelExporter,body:jTt.otelExporter,retryHelps:!1},bridge_offline:{title:_Tt.bridgeOffline,body:jTt.bridgeOffline,retryHelps:!0},ssh_disconnected:{title:_Tt.sshDisconnected,body:jTt.sshDisconnected,retryHelps:!0},cli_rewind_target_not_found:{title:_Tt.rewindTargetNotFound,body:jTt.rewindTargetNotFound,retryHelps:!0},git_checkout_failed:{title:_Tt.gitCheckoutFailed,body:jTt.gitCheckoutFailed,retryHelps:!1},remote_worktree_failed:{title:_Tt.remoteWorktreeFailed,body:jTt.remoteWorktreeFailed,retryHelps:!0},policy_denied:{title:_Tt.policyDenied,body:jTt.policyDenied,retryHelps:!1},binary_locked:{title:_Tt.binaryLocked,body:jTt.binaryLocked,retryHelps:!0}};function STt(e){return void 0===e||(429===e||e>=500)}function NTt(e,t,s){const n=t?MTt[t]:void 0;return n?{title:e.forma